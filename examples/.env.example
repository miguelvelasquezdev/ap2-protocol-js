# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit a real key.

# --- Google AI Studio (recommended for development) ---
# Get a key at https://aistudio.google.com/apikey
# The ADK reads GOOGLE_API_KEY (GEMINI_API_KEY / GOOGLE_GENAI_API_KEY also work).
GOOGLE_API_KEY=your_google_api_key_here

# Model used by every agent. Override here when Google retires one — the agents
# read it from a single place (src/common/config/model.ts).
# Note: `gemini-2.5-flash` is no longer available to new API keys.
GEMINI_MODEL=gemini-3.6-flash

# --- Vertex AI (alternative) ---
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
